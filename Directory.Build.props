<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>MarzOps</Company>
    <Product>Marz Monitor</Product>
    <!-- Fonte única da versão (0.1.x). build-package.py e o instalador leem daqui. -->
    <Version>0.1.32</Version>
    <AssemblyVersion>0.1.32.0</AssemblyVersion>
    <FileVersion>0.1.32.0</FileVersion>
    <Copyright>© 2026 MarzOps</Copyright>
    <RepositoryUrl>https://github.com/marzliak/marz-monitor</RepositoryUrl>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDateUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
